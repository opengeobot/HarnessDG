<?xml version="1.0" encoding="UTF-8"?>
<!--
  功能：HarnessDG 后端 Maven 父 POM，统一依赖管理与构建配置
  时间：2026-05-07
  作者：AxeXie
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.harnessdg</groupId>
    <artifactId>harnessdg-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>HarnessDG Parent</name>
    <description>AI Ontology Data OS - Business Task Data Platform</description>

    <modules>
        <module>harness-common</module>
        <module>harness-model</module>
        <module>harness-dictionary</module>
        <module>harness-config</module>
        <module>harness-auth</module>
        <module>harness-audit</module>
        <module>harness-ontology</module>
        <module>harness-task</module>
        <module>harness-agent-gateway</module>
        <module>harness-app</module>
        <!-- Phase 2 新增模块 -->
        <module>harness-relation</module>
        <module>harness-integration</module>
        <module>harness-approval</module>
        <module>harness-quality</module>
        <module>harness-lineage</module>
        <module>harness-datasource</module>
        <module>harness-report</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 依赖版本管理 -->
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <jjwt.version>0.12.6</jjwt.version>
        <flyway.version>10.15.0</flyway.version>
        <springdoc.version>2.5.0</springdoc.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <caffeine.version>3.1.8</caffeine.version>
        <pgvector-java.version>0.1.6</pgvector-java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 项目内部模块 -->
            <dependency>
                <groupId>com.harnessdg</groupId>
                <artifactId>harness-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.harnessdg</groupId>
                <artifactId>harness-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.harnessdg</groupId>
                <artifactId>harness-dictionary</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.harnessdg</groupId>
                <artifactId>harness-config</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.harnessdg</groupId>
                <artifactId>harness-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.harnessdg</groupId>
                <artifactId>harness-audit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.harnessdg</groupId>
                <artifactId>harness-ontology</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.harnessdg</groupId>
                <artifactId>harness-task</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.harnessdg</groupId>
                <artifactId>harness-agent-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Phase 2 新增模块依赖管理 -->
            <dependency>
                <groupId>com.harnessdg</groupId>
                <artifactId>harness-relation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.harnessdg</groupId>
                <artifactId>harness-integration</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.harnessdg</groupId>
                <artifactId>harness-approval</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.harnessdg</groupId>
                <artifactId>harness-quality</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.harnessdg</groupId>
                <artifactId>harness-lineage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.harnessdg</groupId>
                <artifactId>harness-datasource</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.harnessdg</groupId>
                <artifactId>harness-report</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- MyBatis-Plus -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- JWT -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <!-- Flyway -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>

            <!-- SpringDoc OpenAPI -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- Caffeine Cache -->
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>

            <!-- pgvector Java -->
            <dependency>
                <groupId>com.pgvector</groupId>
                <artifactId>pgvector</artifactId>
                <version>${pgvector-java.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 所有子模块默认引入的依赖 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>aliyun-public</id>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>aliyun-public</id>
            <url>https://maven.aliyun.com/repository/public</url>
        </pluginRepository>
    </pluginRepositories>
</project>
