#!/usr/bin/env bash
# =============================================================================
# aih — AIHub 命令行客户端（最小实现）
#
# 用法:
#   aih <resource> <action> [options]
#
# 资源:
#   dataset    数据集资产管理
#
# 动作:
#   search     搜索数据集
#   inspect    查看资产详情
#   pull       下载版本内容到本地目录（含 SHA-256 校验），或请求下载票据
#   create     创建数据集草稿
#   version    创建草稿版本
#   status     查看资产 provisioning 状态
#   versions   列出资产版本
#   push       创建上传会话并推送本地目录
#   resume     恢复未完成的上传会话
#   verify     校验本地文件与版本 manifest 摘要
#
# 环境变量:
#   AIH_API_URL           API 基址（默认 http://localhost:8080）
#   AIH_TOKEN             JWT 认证令牌（或从 ~/.aih/token 读取）
#   AIH_OUTPUT            输出格式：json（默认）| table
#   AIH_TIMEOUT           请求超时秒数（默认 30）
#   AIH_DOWNLOAD_TIMEOUT  内容下载超时秒数（默认 300）
#   AIH_PASSWORD          login 口令（避免口令进入进程命令行）
#
# 退出码:
#   0  成功
#   1  通用错误
#   2  认证失败
#   3  资源未找到
#   4  冲突
#   5  校验失败
#   6  限流
#   7  服务端错误
# =============================================================================
set -euo pipefail

readonly VERSION="0.3.0"
readonly EXIT_OK=0
readonly EXIT_ERROR=1
readonly EXIT_AUTH=2
readonly EXIT_NOT_FOUND=3
readonly EXIT_CONFLICT=4
readonly EXIT_VALIDATION=5
readonly EXIT_RATE_LIMIT=6
readonly EXIT_SERVER=7

# ---- 配置 ----
API_URL="${AIH_API_URL:-http://localhost:8080}"
TIMEOUT="${AIH_TIMEOUT:-30}"
DOWNLOAD_TIMEOUT="${AIH_DOWNLOAD_TIMEOUT:-300}"
OUTPUT="${AIH_OUTPUT:-json}"

# ---- Token 获取 ----
resolve_token() {
    if [[ -n "${AIH_TOKEN:-}" ]]; then
        echo "$AIH_TOKEN"
    elif [[ -f "${HOME}/.aih/token" ]]; then
        cat "${HOME}/.aih/token"
    else
        echo ""
    fi
}

TOKEN=$(resolve_token)

# ---- 工具函数 ----
die() {
    local code="$1"; shift
    printf '{"error":{"code":"%s","message":"%s"}}\n' "$code" "$*" >&2
    exit "$code"
}

usage() {
    cat <<EOF
aih v${VERSION} — AIHub CLI

用法: aih <resource> <action> [options]

资源与动作:
  dataset search   [--query Q] [--cursor C] [--limit N]   搜索数据集
  dataset inspect  --id <assetId>                         查看资产详情
  dataset pull     --version <versionId> --dir <path>     下载版本内容（SHA-256 校验）
                   [--artifact ID] [--include GLOB] [--exclude GLOB] [--resume]
                   不带 --dir 时仅请求并打印下载票据
  dataset create   --name N --namespace NS --owner-team TEAM_ID  创建数据集草稿
                   [--desc D] [--visibility PRIVATE|INTERNAL|PUBLIC]
  dataset version  --asset <assetId> --version V          创建草稿版本
  dataset status   --id <assetId>                         查看 provisioning 状态
  dataset versions --id <assetId> [--cursor C] [--limit N] 列出资产版本
  dataset push     --asset <assetId> --version <versionId> --dir <path>  推送本地目录
  dataset resume   --session <sessionId> [--asset <assetId>] --dir <path>  恢复上传
  dataset verify   --asset <assetId> --version <versionId> --dir <path>  校验本地文件
  login            --username U (--password-stdin | \$AIH_PASSWORD)

通用选项:
  --api-url URL    API 基址（默认 \$AIH_API_URL）
  --token T        JWT 令牌（默认 \$AIH_TOKEN 或 ~/.aih/token）
  --timeout N      超时秒数（默认 30）
  --output FMT     输出格式 json|table（默认 json）
  --help           显示帮助
  --version        显示版本号

环境变量:
  AIH_API_URL            API 基址
  AIH_TOKEN              JWT 认证令牌
  AIH_OUTPUT             输出格式
  AIH_TIMEOUT            请求超时
  AIH_DOWNLOAD_TIMEOUT   内容下载超时（默认 300）
  AIH_PASSWORD           login 口令（推荐，配合 --password-stdin）

退出码: 0=成功 1=错误 2=认证失败 3=未找到 4=冲突 5=校验失败 6=限流 7=服务端错误
EOF
    exit "$EXIT_OK"
}

# ---- ApiResponse 信封兼容 ----
# 后端成功响应统一为 {"data":<payload>,"requestId":…,"traceId":…,"timestamp":…}；
# 下列助手同时兼容裸对象，字段提取一律经信封解包，避免根取字段静默失效。
extract_field() {
    local field="$1" default="${2:-}"
    python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    print('${default}')
    sys.exit(0)
if isinstance(d, dict):
    inner = d.get('data')
    if isinstance(inner, (dict, list)):
        d = inner
if isinstance(d, dict):
    v = d.get('${field}')
    print('' if v is None else v)
else:
    print('${default}')
" 2>/dev/null || echo "$default"
}

# 幂等键：对产生副作用的 POST 转发 Idempotency-Key（RFC 4122 v4，36 字符）。
# AIH_IDEMPOTENCY_KEY 显式指定时优先使用（同一意图重放场景）。
new_idempotency_key() {
    if [[ -n "${AIH_IDEMPOTENCY_KEY:-}" ]]; then
        printf '%s' "$AIH_IDEMPOTENCY_KEY"
    elif [[ -r /proc/sys/kernel/random/uuid ]]; then
        cat /proc/sys/kernel/random/uuid
    elif command -v uuidgen &>/dev/null; then
        uuidgen | tr 'A-Z' 'a-z'
    else
        python3 -c "import uuid; print(uuid.uuid4())"
    fi
}

# ---- HTTP 请求封装 ----
API_PREFIX="/api/v1"

http_request() {
    local method="$1"
    local path="$2"
    local body="${3:-}"
    local idempotency_key="${4:-}"

    # 确保所有 API 路径以 /api/v1 为前缀
    if [[ "$path" != /api/v1/* ]]; then
        if [[ "$path" == /* ]]; then
            path="${API_PREFIX}${path}"
        else
            path="${API_PREFIX}/${path}"
        fi
    fi

    local -a curl_args=(
        --silent
        --show-error
        --max-time "$TIMEOUT"
        -X "$method"
        -H "Accept: application/json"
        -H "Content-Type: application/json"
        -w "\n%{http_code}"
    )

    if [[ -n "$TOKEN" ]]; then
        curl_args+=(-H "Authorization: Bearer ${TOKEN}")
    fi

    if [[ -n "$idempotency_key" ]]; then
        curl_args+=(-H "Idempotency-Key: ${idempotency_key}")
    fi

    if [[ -n "$body" ]]; then
        curl_args+=(-d "$body")
    fi

    local response
    response=$(curl "${curl_args[@]}" "${API_URL}${path}" 2>&1) || {
        die "$EXIT_ERROR" "HTTP request failed: $response"
    }

    local http_code
    http_code=$(echo "$response" | tail -1)
    local body_resp
    body_resp=$(echo "$response" | sed '$d')

    case "$http_code" in
        200|201|202)
            echo "$body_resp"
            ;;
        401|403)
            die "$EXIT_AUTH" "Authentication failed (HTTP $http_code)"
            ;;
        404)
            die "$EXIT_NOT_FOUND" "Resource not found (HTTP $http_code)"
            ;;
        409)
            # 附带响应体摘要：幂等冲突（同键不同请求指纹）需可从 stderr 判定
            local detail
            detail=$(printf '%s' "$body_resp" | tr -d '"'"'"'\n\r' | cut -c1-300)
            die "$EXIT_CONFLICT" "Conflict (HTTP $http_code) ${detail}"
            ;;
        422)
            die "$EXIT_VALIDATION" "Validation error (HTTP $http_code)"
            ;;
        429)
            die "$EXIT_RATE_LIMIT" "Rate limited (HTTP $http_code)"
            ;;
        5*)
            die "$EXIT_SERVER" "Server error (HTTP $http_code)"
            ;;
        *)
            die "$EXIT_ERROR" "Unexpected HTTP status $http_code"
            ;;
    esac
}

# ---- dataset 子命令 ----
cmd_dataset_search() {
    local query="" cursor="" limit="20"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --query|-q)   query="$2"; shift 2 ;;
            --cursor|-c)  cursor="$2"; shift 2 ;;
            --limit|-l)   limit="$2"; shift 2 ;;
            *)            shift ;;
        esac
    done

    local params="type=DATASET&limit=${limit}"
    [[ -n "$query" ]] && params+="&keyword=${query}"
    [[ -n "$cursor" ]] && params+="&cursor=${cursor}"

    http_request GET "/assets?${params}"
}

cmd_dataset_inspect() {
    local asset_id=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --id|-i)  asset_id="$2"; shift 2 ;;
            *)        shift ;;
        esac
    done

    [[ -z "$asset_id" ]] && die "$EXIT_VALIDATION" "Missing required option: --id"

    http_request GET "/assets/${asset_id}"
}

pull_one_artifact() {
    # pull_one_artifact <version_id> <artifact_id> <dir> <rel_path> <expected_sha256> <resume>
    local version_id="$1" artifact_id="$2" dir="$3" rel="$4" expected="$5" resume="$6"

    local target="${dir}/${rel}"
    if [[ "$resume" -eq 1 && -f "$target" ]]; then
        if [[ -z "$expected" || "$(sha256_file "$target")" == "$expected" ]]; then
            return 0
        fi
        rm -f "$target"
    fi

    local ticket method url
    ticket=$(http_request GET "/versions/${version_id}/download?artifactId=${artifact_id}")
    method=$(printf '%s' "$ticket" | extract_field method "")
    if [[ "$method" != "PRESIGNED_URL" ]]; then
        die "$EXIT_ERROR" "Download ticket method '${method}' is not directly downloadable by this CLI"
    fi
    url=$(printf '%s' "$ticket" | extract_field presignedUrl "")
    [[ -z "$url" ]] && die "$EXIT_ERROR" "Download ticket missing presignedUrl"

    mkdir -p "$(dirname "$target")"
    local part="${target}.part"

    # 票据 URL 自带签名，仅经变量传递，不打印、不落日志
    if ! curl --silent --show-error --max-time "$DOWNLOAD_TIMEOUT" --location \
        --output "$part" "$url"; then
        rm -f "$part"
        die "$EXIT_SERVER" "Failed to download artifact ${artifact_id}"
    fi

    if [[ -n "$expected" ]]; then
        local actual
        actual=$(sha256_file "$part")
        if [[ "$actual" != "$expected" ]]; then
            rm -f "$part"
            die "$EXIT_VALIDATION" "SHA-256 mismatch for ${rel}: expected=${expected} actual=${actual}"
        fi
    fi
    mv -f "$part" "$target"
}

filter_artifacts() {
    # filter_artifacts <include_glob> <exclude_glob> → 每行 "artifactId<TAB>path<TAB>sha256"
    python3 -c "
import sys, json, fnmatch
raw = sys.stdin.read()
d = json.loads(raw)
if isinstance(d, dict):
    inner = d.get('data')
    if isinstance(inner, (dict, list)):
        d = inner
include, exclude = sys.argv[1], sys.argv[2]
for a in d or []:
    rel = a.get('path', '')
    if not rel:
        continue
    if include and not fnmatch.fnmatch(rel, include):
        continue
    if exclude and fnmatch.fnmatch(rel, exclude):
        continue
    print('%s\t%s\t%s' % (a.get('artifactId', ''), rel, (a.get('sha256') or '').lower()))
" "$1" "$2"
}

cmd_dataset_pull() {
    local version_id="" artifact_id="" dir="" include="" exclude="" resume=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --version|-v)    version_id="$2"; shift 2 ;;
            --artifact|-a)   artifact_id="$2"; shift 2 ;;
            --dir|-d)        dir="$2"; shift 2 ;;
            --include)       include="$2"; shift 2 ;;
            --exclude)       exclude="$2"; shift 2 ;;
            --resume)        resume=1; shift ;;
            *)               shift ;;
        esac
    done

    [[ -z "$version_id" ]] && die "$EXIT_VALIDATION" "Missing required option: --version"

    # 票据模式：不带 --dir 时仅签发并打印票据（保持既有行为）
    if [[ -z "$dir" ]]; then
        local path="/versions/${version_id}/download"
        [[ -n "$artifact_id" ]] && path+="?artifactId=${artifact_id}"
        http_request GET "$path"
        return 0
    fi

    # 内容模式：逐工件取 PRESIGNED_URL 票据下载并做 SHA-256 校验
    command -v python3 &>/dev/null || die "$EXIT_ERROR" "python3 is required for content download"
    command -v sha256sum &>/dev/null || die "$EXIT_ERROR" "sha256sum is required for content download"
    mkdir -p "$dir"

    # 整版票据（GIT_DVC 形态）仅用于解析 assetId；内容下载逐工件走 PRESIGNED_URL 票据
    local base_ticket asset_id
    base_ticket=$(http_request GET "/versions/${version_id}/download")
    asset_id=$(printf '%s' "$base_ticket" | extract_field assetId "")
    [[ -z "$asset_id" ]] && die "$EXIT_ERROR" "Cannot resolve assetId from download ticket"

    local artifacts_resp
    artifacts_resp=$(http_request GET "/assets/${asset_id}/versions/${version_id}/artifacts")

    if [[ -n "$artifact_id" ]]; then
        local rel expected
        rel=$(printf '%s' "$artifacts_resp" | python3 -c "
import sys, json
d = json.load(sys.stdin)
if isinstance(d, dict):
    inner = d.get('data')
    if isinstance(inner, list):
        d = inner
for a in d or []:
    if a.get('artifactId') == '${artifact_id}':
        print(a.get('path', '')); break
" 2>/dev/null)
        expected=$(printf '%s' "$artifacts_resp" | python3 -c "
import sys, json
d = json.load(sys.stdin)
if isinstance(d, dict):
    inner = d.get('data')
    if isinstance(inner, list):
        d = inner
for a in d or []:
    if a.get('artifactId') == '${artifact_id}':
        print((a.get('sha256') or '').lower()); break
" 2>/dev/null)
        [[ -z "$rel" ]] && die "$EXIT_NOT_FOUND" "Artifact ${artifact_id} not found in version ${version_id}"
        pull_one_artifact "$version_id" "$artifact_id" "$dir" "$rel" "$expected" "$resume"
        printf '{"status":"ok","versionId":"%s","downloaded":1,"dir":"%s"}\n' "$version_id" "$dir"
        return 0
    fi

    local rows count=0
    rows=$(printf '%s' "$artifacts_resp" | filter_artifacts "$include" "$exclude")
    while IFS=$'\t' read -r aid arel sha; do
        [[ -z "$aid" ]] && continue
        pull_one_artifact "$version_id" "$aid" "$dir" "$arel" "$sha" "$resume"
        count=$((count + 1))
    done <<< "$rows"

    [[ $count -eq 0 ]] && die "$EXIT_NOT_FOUND" "No artifacts matched include='${include}' exclude='${exclude}'"
    printf '{"status":"ok","versionId":"%s","assetId":"%s","downloaded":%d,"dir":"%s"}\n' \
        "$version_id" "$asset_id" "$count" "$dir"
}

cmd_dataset_create() {
    local name="" namespace="" description="" organization_id="" project_id=""
    local owner_team="" visibility="PRIVATE"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name|-n)          name="$2"; shift 2 ;;
            --namespace|-ns)    namespace="$2"; shift 2 ;;
            --description|-d)   description="$2"; shift 2 ;;
            --organization|-o)  organization_id="$2"; shift 2 ;;
            --project|-p)       project_id="$2"; shift 2 ;;
            --owner-team)       owner_team="$2"; shift 2 ;;
            --visibility)       visibility="$2"; shift 2 ;;
            *)                  shift ;;
        esac
    done

    [[ -z "$name" ]] && die "$EXIT_VALIDATION" "Missing required option: --name"
    [[ -z "$namespace" ]] && die "$EXIT_VALIDATION" "Missing required option: --namespace"
    # DEC-011：资产必须归属 ACTIVE 团队；服务端强制，CLI 提前校验给出稳定退出码
    [[ -z "$owner_team" ]] && die "$EXIT_VALIDATION" "Missing required option: --owner-team (DEC-011)"
    case "$visibility" in PRIVATE|INTERNAL|PUBLIC) ;; *) die "$EXIT_VALIDATION" "Invalid --visibility: $visibility (PRIVATE|INTERNAL|PUBLIC)" ;; esac

    local body="{\"name\":\"${name}\",\"namespace\":\"${namespace}\",\"type\":\"DATASET\",\"visibility\":\"${visibility}\",\"ownerTeamId\":\"${owner_team}\""
    [[ -n "$description" ]] && body+=",\"description\":\"${description}\""
    [[ -n "$organization_id" ]] && body+=",\"organizationId\":\"${organization_id}\""
    [[ -n "$project_id" ]] && body+=",\"projectId\":\"${project_id}\""
    body+="}"

    # 资产创建为有副作用的 POST：转发幂等键，重放不重复建资产（AC-DST-CLI-006）
    http_request POST "/assets" "$body" "$(new_idempotency_key)"
}

cmd_dataset_version() {
    local asset_id="" version=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --asset|-a)    asset_id="$2"; shift 2 ;;
            --version|-v)  version="$2"; shift 2 ;;
            *)             shift ;;
        esac
    done

    [[ -z "$asset_id" ]] && die "$EXIT_VALIDATION" "Missing required option: --asset"
    [[ -z "$version" ]] && die "$EXIT_VALIDATION" "Missing required option: --version"

    http_request POST "/assets/${asset_id}/versions" \
        "{\"version\":\"${version}\"}" "$(new_idempotency_key)"
}

cmd_dataset_status() {
    local asset_id=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --id|-i)  asset_id="$2"; shift 2 ;;
            *)        shift ;;
        esac
    done

    [[ -z "$asset_id" ]] && die "$EXIT_VALIDATION" "Missing required option: --id"

    local resp
    resp=$(http_request GET "/assets/${asset_id}")

    # 提取 provisioning_status 和基本信息（经 data 信封解包）
    if command -v python3 &>/dev/null; then
        echo "$resp" | python3 -c "
import sys, json
d = json.load(sys.stdin)
if isinstance(d, dict):
    inner = d.get('data')
    if isinstance(inner, dict):
        d = inner
print(json.dumps({
    'assetId': d.get('assetId', ''),
    'name': d.get('name', ''),
    'type': d.get('type', ''),
    'status': d.get('status', ''),
    'provisioningStatus': d.get('provisioningStatus', ''),
    'ownerId': d.get('ownerId', ''),
    'createdAt': d.get('createdAt', '')
}, indent=2))
" 2>/dev/null || echo "$resp"
    else
        echo "$resp"
    fi
}

cmd_dataset_versions() {
    local asset_id="" cursor="" limit="20"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --id|-i)     asset_id="$2"; shift 2 ;;
            --cursor|-c) cursor="$2"; shift 2 ;;
            --limit|-l)  limit="$2"; shift 2 ;;
            *)           shift ;;
        esac
    done

    [[ -z "$asset_id" ]] && die "$EXIT_VALIDATION" "Missing required option: --id"

    local params="limit=${limit}"
    [[ -n "$cursor" ]] && params+="&cursor=${cursor}"

    http_request GET "/assets/${asset_id}/versions?${params}"
}

PART_SIZE=$((5 * 1024 * 1024))

# ---- dataset push/resume/verify ----

calc_total_bytes() {
    local dir="$1"
    find "$dir" -type f -print0 | xargs -0 stat -c%s 2>/dev/null | awk '{s+=$1} END {print s+0}'
}

count_files() {
    local dir="$1"
    find "$dir" -type f | wc -l | tr -d ' '
}

sha256_file() {
    sha256sum "$1" | awk '{print $1}'
}

poll_session_status() {
    local session_id="$1"
    local max_attempts="${2:-30}"
    local attempt=0
    while [[ $attempt -lt $max_attempts ]]; do
        local resp status
        resp=$(http_request GET "/upload-sessions/${session_id}")
        status=$(echo "$resp" | extract_field status "")
        case "$status" in
            COMPLETED|FAILED|CANCELLED|EXPIRED)
                echo "$resp"
                return 0
                ;;
        esac
        sleep 2
        attempt=$((attempt + 1))
    done
    die "$EXIT_ERROR" "Timed out waiting for session ${session_id}"
}

upload_parts() {
    local session_id="$1"
    local dir="$2"
    local total_bytes="$3"
    local session_json="${4:-}"

    if ! command -v python3 &>/dev/null; then
        die "$EXIT_ERROR" "python3 is required for upload"
    fi

    python3 - "$dir" <<'PY' || die "$EXIT_VALIDATION" "One or more files missing locally"
import os, sys
root = sys.argv[1]
found = False
for dp, _, names in os.walk(root):
    for name in sorted(names):
        path = os.path.join(dp, name)
        if not os.path.isfile(path):
            print(f"File not found: {path}", file=sys.stderr)
            sys.exit(1)
        found = True
if not found:
    print(f"No files found in {root}", file=sys.stderr)
    sys.exit(1)
PY

    local total_parts=$(( (total_bytes + PART_SIZE - 1) / PART_SIZE ))
    [[ $total_parts -lt 1 ]] && total_parts=1

    local bundle_file
    bundle_file=$(mktemp)
    python3 - "$dir" "$bundle_file" <<'PY'
import os, sys
root, out = sys.argv[1], sys.argv[2]
with open(out, "wb") as dest:
    for dp, _, names in os.walk(root):
        for name in sorted(names):
            with open(os.path.join(dp, name), "rb") as f:
                dest.write(f.read())
PY

    local parts_json="["
    local first=1
    local part=1
    while [[ $part -le $total_parts ]]; do
        local etag="" skip=0
        if [[ -n "$session_json" ]]; then
            skip=$(echo "$session_json" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    print(0); sys.exit(0)
parts = d.get('parts') or d.get('data', {}).get('parts') or []
for p in parts:
    if int(p.get('partNumber', 0)) == $part and p.get('status') == 'COMPLETED':
        print(1); sys.exit(0)
print(0)
" 2>/dev/null || echo 0)
        fi

        if [[ "$skip" -eq 1 ]]; then
            etag=$(echo "$session_json" | python3 -c "
import sys, json
d = json.load(sys.stdin)
parts = d.get('parts') or d.get('data', {}).get('parts') or []
for p in parts:
    if int(p.get('partNumber', 0)) == $part:
        print(p.get('etag', '')); break
" 2>/dev/null || echo "")
            [[ -z "$etag" ]] && skip=0
        fi

        if [[ "$skip" -ne 1 ]]; then
            local presign_resp url part_file headers
            presign_resp=$(http_request GET "/upload-sessions/${session_id}/parts/${part}/presign")
            url=$(echo "$presign_resp" | extract_field url "")
            [[ -z "$url" ]] && { rm -f "$bundle_file"; die "$EXIT_ERROR" "Failed to obtain presigned URL for part ${part}"; }

            part_file=$(mktemp)
            dd if="$bundle_file" of="$part_file" bs="$PART_SIZE" skip=$((part - 1)) count=1 status=none 2>/dev/null \
                || { rm -f "$bundle_file" "$part_file"; die "$EXIT_ERROR" "Failed to extract part ${part}"; }

            headers=$(curl -sS -T "$part_file" -D - -o /dev/null "$url") \
                || { rm -f "$bundle_file" "$part_file"; die "$EXIT_ERROR" "Failed to upload part ${part}"; }
            rm -f "$part_file"
            # HTTP 头以 CRLF 分行：必须剥离 \r，否则 etag 进入 JSON 体导致服务端解析 500
            etag=$(echo "$headers" | awk 'tolower($0) ~ /^etag:/ {gsub(/\r/,"",$2); gsub(/"/, "", $2); print $2; exit}')
            [[ -z "$etag" ]] && { rm -f "$bundle_file"; die "$EXIT_ERROR" "Missing ETag for part ${part}"; }
        fi

        [[ $first -eq 0 ]] && parts_json+=","
        first=0
        parts_json+="{\"partNumber\":${part},\"etag\":\"${etag}\"}"
        part=$((part + 1))
    done
    parts_json+="]"
    rm -f "$bundle_file"

    local files_json="[]"
    files_json=$(python3 - "$dir" <<'PY'
import json, os, sys, hashlib
root = sys.argv[1]
files = []
for dp, _, names in os.walk(root):
    for name in sorted(names):
        path = os.path.join(dp, name)
        if not os.path.isfile(path):
            print(json.dumps({"error": f"File not found: {path}"}))
            sys.exit(1)
        rel = os.path.relpath(path, root).replace("\\", "/")
        h = hashlib.sha256()
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1024 * 1024), b""):
                h.update(chunk)
        files.append({
            "path": rel,
            "sha256": h.hexdigest(),
            "size": os.path.getsize(path),
            "mediaType": "application/octet-stream"
        })
print(json.dumps(files))
PY
)

    # complete 为有副作用的 POST：转发幂等键，避免重放产生重复物化提交
    http_request POST "/upload-sessions/${session_id}/complete" \
        "{\"parts\":${parts_json},\"files\":${files_json}}" \
        "$(new_idempotency_key)"
}

cmd_dataset_push() {
    local asset_id="" version_id="" dir=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --asset|-a)     asset_id="$2"; shift 2 ;;
            --version|-v)   version_id="$2"; shift 2 ;;
            --dir|-d)       dir="$2"; shift 2 ;;
            *)              shift ;;
        esac
    done

    [[ -z "$asset_id" ]] && die "$EXIT_VALIDATION" "Missing required option: --asset"
    [[ -z "$version_id" ]] && die "$EXIT_VALIDATION" "Missing required option: --version"
    [[ -z "$dir" || ! -d "$dir" ]] && die "$EXIT_VALIDATION" "Missing or invalid --dir"

    local total_bytes file_count session_resp session_id
    total_bytes=$(calc_total_bytes "$dir")
    file_count=$(count_files "$dir")
    [[ "$file_count" -eq 0 ]] && die "$EXIT_VALIDATION" "No files found in ${dir}"

    # 上传会话创建为有副作用的 POST：转发幂等键（后端 UploadController 消费面见 EVD 登记）
    session_resp=$(http_request POST "/assets/${asset_id}/versions/${version_id}/upload-sessions" \
        "{\"totalBytes\":${total_bytes},\"fileCount\":${file_count},\"ttlSeconds\":7200}" \
        "$(new_idempotency_key)")
    session_id=$(echo "$session_resp" | extract_field sessionId "")
    [[ -z "$session_id" ]] && die "$EXIT_ERROR" "Failed to extract sessionId"

    upload_parts "$session_id" "$dir" "$total_bytes"
    poll_session_status "$session_id"
}

cmd_dataset_resume() {
    local session_id="" asset_id="" dir=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --session|-s)   session_id="$2"; shift 2 ;;
            --asset|-a)     asset_id="$2"; shift 2 ;;
            --dir|-d)       dir="$2"; shift 2 ;;
            *)              shift ;;
        esac
    done

    [[ -z "$session_id" ]] && die "$EXIT_VALIDATION" "Missing required option: --session"
    [[ -z "$dir" || ! -d "$dir" ]] && die "$EXIT_VALIDATION" "Missing or invalid --dir"

    local path="/upload-sessions/${session_id}"
    [[ -n "$asset_id" ]] && path="/assets/${asset_id}/upload-sessions/${session_id}"

    local session_resp total_bytes
    session_resp=$(http_request GET "$path")
    total_bytes=$(echo "$session_resp" | extract_field totalBytes 0)

    upload_parts "$session_id" "$dir" "$total_bytes" "$session_resp"
    poll_session_status "$session_id"
}

cmd_dataset_verify() {
    local asset_id="" version_id="" dir=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --asset|-a)     asset_id="$2"; shift 2 ;;
            --version|-v)   version_id="$2"; shift 2 ;;
            --dir|-d)       dir="$2"; shift 2 ;;
            *)              shift ;;
        esac
    done

    [[ -z "$asset_id" ]] && die "$EXIT_VALIDATION" "Missing required option: --asset"
    [[ -z "$version_id" ]] && die "$EXIT_VALIDATION" "Missing required option: --version"
    [[ -z "$dir" || ! -d "$dir" ]] && die "$EXIT_VALIDATION" "Missing or invalid --dir"

    local version_resp manifest_digest
    version_resp=$(http_request GET "/assets/${asset_id}/versions/${version_id}")
    manifest_digest=$(echo "$version_resp" | extract_field manifestDigest "")

    local artifacts_resp
    artifacts_resp=$(http_request GET "/assets/${asset_id}/versions/${version_id}/artifacts")

    if command -v python3 &>/dev/null; then
        echo "$artifacts_resp" | python3 - "$dir" "$manifest_digest" <<'PY'
import json, os, sys, hashlib

artifacts = json.load(sys.stdin)
if isinstance(artifacts, dict):
    inner = artifacts.get("data")
    if isinstance(inner, list):
        artifacts = inner
root = sys.argv[1]
manifest_digest = sys.argv[2]
errors = []
checked = 0

for art in artifacts:
    rel = art.get("path", "")
    expected = (art.get("sha256") or "").lower()
    local = os.path.join(root, rel)
    if not os.path.isfile(local):
        errors.append(f"missing: {rel}")
        continue
    h = hashlib.sha256()
    with open(local, "rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    actual = h.hexdigest()
    checked += 1
    if expected and actual != expected:
        errors.append(f"mismatch: {rel} expected={expected} actual={actual}")

result = {
    "verified": len(errors) == 0,
    "manifestDigest": manifest_digest or None,
    "artifactsChecked": checked,
    "errors": errors,
}
print(json.dumps(result, indent=2))
sys.exit(0 if result["verified"] else 5)
PY
    else
        echo "$artifacts_resp"
    fi
}

# ---- 登录 ----
cmd_login() {
    local username="" password="" from_stdin=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --username|-u)       username="$2"; shift 2 ;;
            --password|-p)       password="$2"
                                 # 口令经命令行进入进程表（ps / auditd 可见），仅为兼容保留
                                 printf '{"warn":"--password exposes the secret in the process list; prefer --password-stdin or AIH_PASSWORD"}\n' >&2
                                 shift 2 ;;
            --password-stdin)    from_stdin=1; shift ;;
            *)                   shift ;;
        esac
    done

    [[ -z "$username" ]] && die "$EXIT_VALIDATION" "Missing required option: --username"

    if [[ "$from_stdin" -eq 1 ]]; then
        IFS= read -r password || true
    elif [[ -z "$password" && -n "${AIH_PASSWORD:-}" ]]; then
        password="$AIH_PASSWORD"
    fi
    [[ -z "$password" ]] && die "$EXIT_VALIDATION" "Missing password: use --password-stdin, AIH_PASSWORD, or --password"

    # 口令仅经环境变量传入子进程，避免出现在命令行与 shell 历史
    local body resp
    body=$(AIH_LOGIN_USER="$username" AIH_LOGIN_PASS="$password" python3 -c "
import json, os
print(json.dumps({'username': os.environ['AIH_LOGIN_USER'], 'password': os.environ['AIH_LOGIN_PASS']}))
")
    # 临时清除 TOKEN 以避免发送旧的 Authorization header
    TOKEN=""
    resp=$(http_request POST "/auth/login" "$body")

    # 提取 access token 并保存
    if command -v python3 &>/dev/null; then
        local access_token
        access_token=$(echo "$resp" | extract_field accessToken "")
        if [[ -n "$access_token" ]]; then
            mkdir -p "${HOME}/.aih"
            chmod 700 "${HOME}/.aih"
            echo -n "$access_token" > "${HOME}/.aih/token"
            chmod 600 "${HOME}/.aih/token"
            echo '{"status":"ok","message":"Token saved to ~/.aih/token"}'
        else
            die "$EXIT_AUTH" "Failed to extract access token from response"
        fi
    else
        echo "$resp"
    fi
}

# ---- 主入口 ----
main() {
    [[ $# -eq 0 ]] && usage

    # 全局选项解析
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)    usage ;;
            --version|-V) echo "aih v${VERSION}"; exit 0 ;;
            --api-url)    API_URL="$2"; shift 2 ;;
            --token)      TOKEN="$2"; shift 2 ;;
            --timeout)    TIMEOUT="$2"; shift 2 ;;
            --output)     OUTPUT="$2"; shift 2 ;;
            --)           shift; break ;;
            -*)           die "$EXIT_ERROR" "Unknown option: $1" ;;
            *)            break ;;
        esac
    done

    local resource="${1:-}"
    local action="${2:-}"
    # 单词命令（如 login）的第二个 token 是选项而非 action，需保留给子命令解析
    case "$action" in
        -*|"") action=""; shift 1 2>/dev/null || true ;;
        *)     shift 2 2>/dev/null || true ;;
    esac

    case "${resource}/${action}" in
        login|login/)  cmd_login "$@" ;;
        dataset/search)  cmd_dataset_search "$@" ;;
        dataset/inspect) cmd_dataset_inspect "$@" ;;
        dataset/pull)    cmd_dataset_pull "$@" ;;
        dataset/create)  cmd_dataset_create "$@" ;;
        dataset/version) cmd_dataset_version "$@" ;;
        dataset/status)  cmd_dataset_status "$@" ;;
        dataset/versions) cmd_dataset_versions "$@" ;;
        dataset/push)    cmd_dataset_push "$@" ;;
        dataset/resume)  cmd_dataset_resume "$@" ;;
        dataset/verify)  cmd_dataset_verify "$@" ;;
        *)               die "$EXIT_ERROR" "Unknown command: ${resource} ${action}" ;;
    esac
}

main "$@"
