# ModelHub v1 部署环境变量样例 —— 复制为 deploy/.env 后按需修改；
# 未设置的键回落到 docker-compose.yml 内置默认值（与集成测试凭据一致，仅供本机部署）。

# --- PostgreSQL ---
# POSTGRES_DB=modelhub
# POSTGRES_USER=modelhub
# POSTGRES_PASSWORD=modelhub

# --- MinIO（MINIO_ROOT_USER/PASSWORD 同时作为 app 的 artifact access/secret key）---
# MINIO_ROOT_USER=modelhub
# MINIO_ROOT_PASSWORD=ModelHub-Minio-1x
# FILE-002：预签名 URL 公网基址（客户端可达，禁止内部服务名；远程部署改为宿主机/网关地址）
# MINIO_PUBLIC_BASE_URL=http://localhost:9000

# --- Gitea ---
# GITEA_ROOT_URL=http://localhost:3000/
# GITEA_ADMIN_USER=modelhub
# GITEA_ADMIN_PASSWORD=ModelHub-Root-1x

# --- 首个 platform_admin（应用侧 bootstrap）---
# BOOTSTRAP_USERNAME=platform-root
# BOOTSTRAP_PASSWORD=Boot-Strap-1x

# --- 安全 ---
# 浏览器 Origin 白名单（逗号分隔；为空则 refresh/logout fail-closed 拒绝）
# MODEHUB_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# PKCS#8 PEM 私钥（换行用 \n）；留空则每次启动生成临时密钥（仅限非生产）
# MODEHUB_JWT_PRIVATE_KEY_PEM=
# 业务 API 公网基址（git source 下载端点绝对 URL 前缀，走 Nginx 入口）
# PUBLIC_API_BASE_URL=http://localhost:8081
