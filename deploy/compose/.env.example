# ============================================================================
# 功能: AIHub Compose 部署基线环境变量示例。复制为 .env 后按需修改。
#       所有值均为占位/开发默认，禁止把生产 Secret 写入本文件或提交到 Git。
# 时间: 2026-06-29
# 作者: AxeXie
# ============================================================================

# ---- PostgreSQL ----
POSTGRES_USER=aihub
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=aihub

# ---- MinIO 根账号（仅初始化使用，应用不得使用 Root 凭据）----
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=change-me-minio-root

# ---- MinIO 业务服务账号（由 minio-init 创建并赋最小权限）----
# Gitea 存储账号
GITEA_MINIO_ACCESS_KEY=gitea-minio-key
GITEA_MINIO_SECRET_KEY=change-me-gitea-minio
# 后端业务账号（暂存/预览/签名）
AIHUB_MINIO_ACCESS_KEY=aihub-minio-key
AIHUB_MINIO_SECRET_KEY=change-me-aihub-minio
# DVC Remote 账号（Worker / CLI 使用；与后端 scoped 凭据共用 dvc-user）
DVC_ACCESS_KEY=dvc-user-key
DVC_SECRET_KEY=change-me-dvc-user
# 后端 DVC 凭据签发（Compose minio-init 创建的 dvc-user；可与 DVC_ACCESS_KEY 相同）
AIHUB_MINIO_DVC_ACCESS_KEY=dvc-user-key
AIHUB_MINIO_DVC_SECRET_KEY=change-me-dvc-user

# ---- Gitea ----
# 对外可访问的 Gitea Root URL（经 Nginx /git/ 暴露）。
# 此地址既是 Gitea Web 唯一访问入口（不单独暴露 3000），也是未来 SSO 免登跳转/
# OAuth 回调的基准地址；接入认证体系时保持此值不变。
GITEA_PUBLIC_URL=http://localhost:8080/git/
# 后端访问 Gitea 的服务 Token。
# 注意：compose.yaml 的可部署 Profile 已显式设置 AIHUB_GITEA_ENABLED=true，
# 因此该 Token 是**必填前置条件**（不是可选优化）：下方占位值无法鉴权，
# 会让资产建仓按可重试依赖错误持续失败，最终进入 DEAD。
# 生成方式：在 Gitea (http://localhost:8080/git/) 创建服务账号后签发 Token，
# 通过 ./scripts/bootstrap.ps1 的提示或 .env.local 写回，勿提交 Git。
GITEA_SERVICE_TOKEN=replace-with-bootstrap-generated-token
# push webhook HMAC 密钥：建仓侧注册与入站验签共用此单源，缺失则不注册、回调一律 401。
# 生成方式：openssl rand -hex 32，勿提交真实值。
AIHUB_GITEA_WEBHOOK_SECRET=replace-with-random-hmac-secret
# Gitea 回调平台的地址（容器网络内可达）；默认经 backend 服务名直连，无需经 Nginx。
AIHUB_GITEA_WEBHOOK_URL=http://backend:8080/api/v1/webhooks/gitea

# ---- MinIO 对外公开 Endpoint（用于生成预签名 URL；浏览器经宿主机回环 9000 端口直连 API，
# ---- 不经 Nginx——REQ-UPL-002 明确 Nginx/Backend 不代理文件 bytes）----
MINIO_PUBLIC_URL=http://localhost:9000
# 允许跨源直传的来源（逗号分隔多 Origin）：8080 = Nginx 容器前端、5173 = 宿主 Vite dev server（e2e 基线口径）
# 生产多域名属部署面另议
MINIO_CORS_ALLOW_ORIGIN=http://localhost:8080,http://localhost:5173

# ---- 首个管理员引导（本地开发/验收默认）----
# 用于 verify 脚本验证 JWT 生命周期与登录/改密流程。
# 生产环境禁止使用明文口令：改用 AIHUB_BOOTSTRAP_ADMIN_PASSWORD_FILE 指向 Secret 文件，且首登强制改密。
AIHUB_BOOTSTRAP_ADMIN_USERNAME=admin
AIHUB_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-01
